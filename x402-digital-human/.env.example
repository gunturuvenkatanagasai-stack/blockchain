# ==============================================================================
# DIGITAL HUMAN MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and replace placeholder values with actual operational keys.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_bytes_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_32_bytes_long
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/digital_human_db?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Vector Database (Qdrant / Milvus / Pinecone)
VECTOR_DB_TYPE=qdrant
VECTOR_DB_URL="http://localhost:6333"
VECTOR_DB_API_KEY=""

# AI Model Provider (OpenAI / Gemini / Anthropic / Ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Voice AI (Speech-to-Text & Text-to-Speech)
STT_PROVIDER=whisper
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Algorand Blockchain & x402 Protocol
BLOCKCHAIN_NETWORK=testnet
ALGOD_SERVER="https://testnet-api.algonode.cloud"
ALGOD_PORT=""
ALGOD_TOKEN=""
INDEXER_SERVER="https://testnet-idx.algonode.cloud"
INDEXER_PORT=""
INDEXER_TOKEN=""
PLATFORM_TREASURY_ADDRESS="YOUR_ALGORAND_TESTNET_TREASURY_ADDRESS"
PLATFORM_TREASURY_MNEMONIC="25_words_mnemonic_for_testing_only_never_commit"

# x402 Payment Configuration
X402_NETWORK=algorand-testnet
X402_PRICE_PER_QUERY_MICRO_USDC=50000 # 0.05 USDC per query
X402_PAYMENT_RECEIVER_ADDRESS="YOUR_ALGORAND_TESTNET_TREASURY_ADDRESS"

# Object Storage (S3 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=digital-human-knowledge
OBJECT_STORAGE_ACCESS_KEY=minio_admin
OBJECT_STORAGE_SECRET_KEY=minio_secret_password

# Email & Notifications
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="noreply@digitalhuman.marketplace"
