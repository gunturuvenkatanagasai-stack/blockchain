datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRoleEnum {
  LEARNER
  PROFESSIONAL
  EXPERT
  HEALTHCARE_EDUCATOR
  CAREER_MENTOR
  BUSINESS_MENTOR
  ENTERPRISE_ADMIN
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum VerificationStatusEnum {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DigitalTwinModeEnum {
  TEACHER
  MENTOR
  INTERVIEWER
  COACH
  PRACTICE
  REVIEWER
  STUDY
  VOICE
}

enum DocumentStatusEnum {
  UPLOADED
  PROCESSING
  INDEXING
  READY
  FAILED
}

enum PaymentStatusEnum {
  PENDING
  AUTHORIZED
  SETTLED
  FAILED
  REFUNDED
}

enum SubscriptionStatusEnum {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

// ------------------------------------------------------------------------------
// CORE TABLES (1 to 28)
// ------------------------------------------------------------------------------

// 1. Users
model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  passwordHash          String
  fullName              String
  avatarUrl             String?
  bio                   String?
  languages             String[]            @default(["en"])
  interests             String[]            @default([])
  algorandAddress       String?             @unique
  isEmailVerified       Boolean             @default(false)
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  userRoles             UserRole[]
  expertProfile         Expert?
  conversations         Conversation[]
  userMemories          Memory[]
  subscriptions         Subscription[]
  payments              Payment[]
  reviews               Review[]
  learningGoals         LearningGoal[]
  achievements          Achievement[]
  notifications         Notification[]
  orgMemberships        OrganizationMember[]
  auditLogs             AuditLog[]
  supportTickets        SupportTicket[]
}

// 2. Roles
model Role {
  id          String         @id @default(uuid())
  name        UserRoleEnum   @unique
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
}

// 3. Permissions
model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // e.g., "digital_twin:create", "expert:verify"
  description String?
  roles       RolePermission[]
}

// 4. UserRoles
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// 5. Experts
model Expert {
  id                     String                 @id @default(uuid())
  userId                 String                 @unique
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  organization           String?
  experienceYears        Int                    @default(0)
  verificationStatus     VerificationStatusEnum @default(UNVERIFIED)
  ratingAverage          Float                  @default(0.0)
  totalReviews           Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  verifications          ExpertVerification[]
  digitalTwins           DigitalTwin[]
  creatorBalances        CreatorBalance[]
  payouts                Payout[]
}

// 6. ExpertVerifications
model ExpertVerification {
  id                 String                 @id @default(uuid())
  expertId           String
  expert             Expert                 @relation(fields: [expertId], references: [id], onDelete: Cascade)
  identityDocUrl     String
  professionalProof  String
  status             VerificationStatusEnum @default(PENDING_REVIEW)
  adminNotes         String?
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
}

// 7. DigitalTwins
model DigitalTwin {
  id                      String                @id @default(uuid())
  expertId                String
  expert                  Expert                @relation(fields: [expertId], references: [id], onDelete: Cascade)
  name                    String
  tagline                 String
  description             String
  systemPromptInstruction String
  primaryLanguage         String                @default("en")
  supportedModes          DigitalTwinModeEnum[]
  pricePerQueryMicroUsdc  Int                   @default(50000)
  monthlyPlanPriceMicroUsdc Int                 @default(10000000)
  version                 String                @default("1.0.0")
  isActive                Boolean               @default(true)
  onChainAssetId          BigInt?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  twinVersions            DigitalTwinVersion[]
  knowledgeSources        KnowledgeSource[]
  documents               Document[]
  conversations           Conversation[]
  subscriptions           Subscription[]
  creatorBalances         CreatorBalance[]
  licenses                License[]
  contentHashes           ContentHash[]
}

// 8. DigitalTwinVersions
model DigitalTwinVersion {
  id                      String      @id @default(uuid())
  digitalTwinId           String
  digitalTwin             DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  version                 String
  systemPromptInstruction String
  changelog               String?
  createdAt               DateTime    @default(now())
}

// 9. KnowledgeSources
model KnowledgeSource {
  id            String      @id @default(uuid())
  digitalTwinId String
  digitalTwin   DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  name          String
  type          String      // e.g. "PDF_COLLECTION", "AUDIO_ARCHIVE", "GIT_REPO"
  description   String?
  documents     Document[]
  createdAt     DateTime    @default(now())
}

// 10. Documents
model Document {
  id                 String             @id @default(uuid())
  digitalTwinId      String
  knowledgeSourceId  String?
  digitalTwin        DigitalTwin        @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  knowledgeSource    KnowledgeSource?   @relation(fields: [knowledgeSourceId], references: [id], onDelete: SetNull)
  title              String
  fileMimeType       String
  fileSizeBytes      BigInt
  storageUrl         String
  contentHashSha256  String
  status             DocumentStatusEnum @default(UPLOADED)
  chunkCount         Int                @default(0)
  createdAt          DateTime           @default(now())

  documentVersions   DocumentVersion[]
  documentChunks     DocumentChunk[]
}

// 11. DocumentVersions
model DocumentVersion {
  id                String   @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version           Int      @default(1)
  storageUrl        String
  contentHashSha256 String
  createdAt         DateTime @default(now())
}

// 12. DocumentChunks
model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  content        String
  tokenCount     Int
  vectorId       String?  // References external vector database index point
  createdAt      DateTime @default(now())

  @@index([documentId, chunkIndex])
}

// 13. Conversations
model Conversation {
  id            String              @id @default(uuid())
  userId        String
  digitalTwinId String
  mode          DigitalTwinModeEnum @default(TEACHER)
  title         String              @default("New Learning Session")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalTwin   DigitalTwin         @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  messages      Message[]
}

// 14. Messages
model Message {
  id             String      @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     String      // "USER" or "DIGITAL_TWIN"
  content        String
  citationsJson  String?     // JSON string storing document chunk references
  tokensUsed     Int         @default(0)
  createdAt      DateTime    @default(now())
}

// 15. Memories
model Memory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryKey  String
  memoryVal  String
  consentGiven Boolean @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, memoryKey])
}

// 16. Subscriptions
model Subscription {
  id                 String                 @id @default(uuid())
  userId             String
  digitalTwinId      String
  planId             String?
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalTwin        DigitalTwin            @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  status             SubscriptionStatusEnum @default(ACTIVE)
  currentPeriodStart DateTime               @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime               @default(now())
}

// 17. SubscriptionPlans
model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  tier          String   // WEEKLY, MONTHLY, ANNUAL, ENTERPRISE
  priceMicroUsdc Int
  features      String[]
  createdAt     DateTime @default(now())
}

// 18. UsageRecords
model UsageRecord {
  id             String   @id @default(uuid())
  userId         String
  digitalTwinId  String
  queryCount     Int      @default(1)
  voiceSeconds   Int      @default(0)
  tokensConsumed Int      @default(0)
  costMicroUsdc  Int      @default(0)
  recordedAt     DateTime @default(now())
}

// 19. Payments
model Payment {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMicroUsdc    Int
  paymentMethod      String            // "X402_ALGORAND", "FIAT_STRIPE"
  status             PaymentStatusEnum @default(PENDING)
  txHash             String?           @unique
  createdAt          DateTime          @default(now())

  paymentEvents      PaymentEvent[]
}

// 20. PaymentEvents
model PaymentEvent {
  id         String   @id @default(uuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType  String   // "AUTHORIZATION", "SETTLEMENT", "REVERSAL"
  payload    String?
  createdAt  DateTime @default(now())
}

// 21. CreatorBalances
model CreatorBalance {
  id                   String      @id @default(uuid())
  expertId             String
  digitalTwinId        String
  expert               Expert      @relation(fields: [expertId], references: [id], onDelete: Cascade)
  digitalTwin          DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  grossMicroUsdc       Int         @default(0)
  platformFeeMicroUsdc Int         @default(0)
  creatorNetMicroUsdc  Int         @default(0)
  withdrawnMicroUsdc   Int         @default(0)
  updatedAt            DateTime    @updatedAt
}

// 22. Payouts
model Payout {
  id              String   @id @default(uuid())
  expertId        String
  expert          Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  amountMicroUsdc Int
  algorandTxId    String   @unique
  status          String   // "PROCESSING", "COMPLETED", "FAILED"
  createdAt       DateTime @default(now())
}

// 23. Licenses
model License {
  id            String      @id @default(uuid())
  digitalTwinId String
  digitalTwin   DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  licenseeEmail String
  licenseType   String      // "INDIVIDUAL_PERPETUAL", "ENTERPRISE_SEAT"
  txHash        String?
  createdAt     DateTime    @default(now())
}

// 24. ContentHashes
model ContentHash {
  id                String      @id @default(uuid())
  digitalTwinId     String
  digitalTwin       DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  contentHashSha256 String
  onChainTxId       String?
  registeredAt      DateTime    @default(now())
}

// 25. BlockchainTransactions
model BlockchainTransaction {
  id            String   @id @default(uuid())
  network       String   // "algorand-testnet", "algorand-mainnet"
  txId          String   @unique
  senderAddress String
  receiverAddr  String
  amount        BigInt
  assetId       BigInt?
  confirmedRound BigInt?
  createdAt     DateTime @default(now())
}

// 26. Reviews
model Review {
  id        String   @id @default(uuid())
  userId    String
  expertId  String
  rating    Int
  comment   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 27. LearningGoals & Achievements
model LearningGoal {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalTitle        String
  targetRoadmapJson String
  progressPercent  Float    @default(0.0)
  createdAt        DateTime @default(now())
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeName   String
  unlockedAt  DateTime @default(now())
}

// 28. System Governance (Notifications, Organizations, AuditLogs, SupportTickets)
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())

  members   OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       // "ADMIN", "MEMBER"
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String   // "OPEN", "IN_PROGRESS", "CLOSED"
  createdAt DateTime @default(now())
}
